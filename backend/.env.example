# TableTalk Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabletalk

# JWT Secret (generate a random string)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenCode Go API (OpenAI-compatible)
OPENCODE_GO_API_KEY=your-opencode-go-api-key-here
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash
OPENCODE_GO_THINKING=disabled
OPENCODE_GO_TEMPERATURE=0
OPENCODE_GO_TOP_P=1
OPENCODE_GO_MAX_TOKENS=2000
OPENCODE_GO_HISTORY_LIMIT=50
OPENCODE_GO_PROXY_URL=

# DeepSeek native API
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TOP_P=1
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_HISTORY_LIMIT=50
DEEPSEEK_PROXY_URL=

# Server
HOST=0.0.0.0
PORT=8570
DEBUG=true
